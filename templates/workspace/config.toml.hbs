# Rendered by ClawOps provisioner for user {{openid}} (uid {{linux_uid}}).
# Generated file — managed by ClawOps. Manual edits will be overwritten on
# re-provision. To override secrets, set ZEROCLAW_API_KEY in the per-user
# systemd environment, not in this file.

# ── Provider & model ────────────────────────────────────────
{{#if llm.api_key}}
api_key = "{{llm.api_key}}"
{{/if}}
default_provider = "{{llm.default_provider}}"
default_model = "{{llm.default_model}}"
default_temperature = {{llm.default_temperature}}
provider_timeout_secs = {{llm.provider_timeout_secs}}

{{#if llm.api_url}}
# 仅在显式配置了 api_url 时才覆盖 provider 定义。
# ⚠️ 一旦覆盖，provider 名会变成 "custom:<url>"，成本账本的 key 也随之
# 变成 "custom:<url>/<model>"，与 [cost.prices] 里按 "<provider>/<model>"
# 写的条目对不上 —— 计费会静默归零、限额形同虚设。所以自带的 provider
# （deepseek 等）不要配 api_url，直接用内置定义。
# 强制 wire_api = "chat_completions" 跳过 Responses API 探测。
[model_providers]
[model_providers.{{llm.default_provider}}]
name = "{{llm.default_provider}}"
base_url = "{{llm.api_url}}"
wire_api = "chat_completions"
{{/if}}

# ── Observability ──────────────────────────────────────────
[observability]
backend = "log"
runtime_trace_mode = "rolling"
runtime_trace_path = "state/runtime-trace.jsonl"
runtime_trace_max_entries = 300
event_webhook_url = "{{sop_webhook.event_webhook_url}}"

# ── Autonomy ───────────────────────────────────────────────
# Multi-tenant safety: shell auto_approve is OFF, forbidden_paths
# blocks reading neighbouring users' homes. Per-user budget cap.
[autonomy]
level = "supervised"
workspace_only = true
allowed_commands = [
    "ls", "cat", "grep", "find", "echo", "pwd", "wc", "head", "tail", "date",
    "python3", "pip3", "jq", "curl", "wget"
]
forbidden_paths = [
    "/etc", "/root", "/home", "/usr", "/bin", "/sbin",
    "/lib", "/boot", "/dev", "/proc", "/sys", "/var", "/tmp",
    "~/.ssh", "~/.gnupg", "~/.aws", "~/.config"
]
max_actions_per_hour = 120
# 0 = 不限（实测确认：耗费远超 0 也不拦）。真正生效的是下方 [cost]
# 的 daily_limit_usd；这里保持 0 以免两套限额各算各的、互相打架。
max_cost_per_day_cents = {{llm.max_cost_per_day_cents}}
require_approval_for_medium_risk = true
block_high_risk_commands = true
# MYSQL_* 必须在此白名单里：守护进程的环境变量不会自动传给 shell 子进程，
# 而 scripts/query_enterprise_db.py 与 scripts/search_enterprise.py 都靠它们连库。
# 漏掉会静默降级为「数据库连接参数不完整」，SOP 照跑但查不到内部数据。
shell_env_passthrough = [
    "PATH",
    "HOME",
    "VIRTUAL_ENV",
    "MYSQL_HOST",
    "MYSQL_PORT",
    "MYSQL_USER",
    "MYSQL_PASSWORD",
    "MYSQL_DATABASE",
    "ENTERPRISE_DETAIL_URL_TEMPLATE",
]
auto_approve = ["file_read", "memory_recall", "web_fetch", "web_search_tool"]
always_ask = ["shell", "file_write"]

# ── Security ───────────────────────────────────────────────
[security.sandbox]
backend = "auto"

[security.resources]
max_memory_mb = 512
max_cpu_time_seconds = 90
max_subprocesses = 10
memory_monitoring = true

[security.audit]
enabled = true
log_path = "audit.log"
max_size_mb = 50
sign_events = false

[security.estop]
enabled = true
state_file = ".zeroclaw/estop-state.json"
require_otp_to_resume = false

# ── Runtime ────────────────────────────────────────────────
[runtime]
kind = "native"

# ── Reliability ────────────────────────────────────────────
[reliability]
provider_retries = 2
provider_backoff_ms = 2000

# ── Scheduler ──────────────────────────────────────────────
[scheduler]
enabled = true
max_tasks = 16
max_concurrent = 2

# ── Agent ──────────────────────────────────────────────────
[agent]
compact_context = true
max_tool_iterations = 80
max_history_messages = 30
parallel_tools = false
tool_dispatcher = "auto"

# ── Skills ─────────────────────────────────────────────────
[skills]
open_skills_enabled = false
prompt_injection_mode = "compact"

# Heartbeat is intentionally omitted — ClawOps drives any reminders.
# Empty section would still require interval_minutes; falling back to
# zeroclaw defaults is fine.

# ── Cron ───────────────────────────────────────────────────
[cron]
enabled = true
max_run_history = 30

# ── SOP engine ─────────────────────────────────────────────
# SOP engine is auto-enabled when <workspace>/sops/<name>/ exists.
# This block is intentionally minimal — SopConfig defaults are fine.
# (No `enabled` field exists in SopConfig; defaults: sops_dir=<workspace>/sops,
# default_execution_mode=supervised, max_concurrent_total=4.)
# Used by the policy-match SOP routed from IDENTITY.
[sop]

# ── Channels — disabled, gateway-only access via ClawOps ───
[channels_config]
cli = false

# ── Memory ─────────────────────────────────────────────────
# auto_save = false on purpose: when true, every user message is
# persisted and resurfaces via build_context on later turns, which
# leaks cross-session history into the current prompt. The agent
# can still call memory_store explicitly to record durable facts.
[memory]
backend = "sqlite"
auto_save = false
hygiene_enabled = true
archive_after_days = 90
purge_after_days = 365
conversation_retention_days = 30
embedding_provider = "none"
snapshot_enabled = true
snapshot_on_hygiene = true
auto_hydrate = true

# ── Gateway — bind to localhost only, ClawOps fronts the world ─
[gateway]
host = "127.0.0.1"
port = {{port}}
allow_public_bind = false
public_url = "http://127.0.0.1:{{port}}"
require_pairing = true
paired_tokens = ["{{paired_token}}"]
pair_rate_limit_per_minute = 10
webhook_rate_limit_per_minute = 60
trust_forwarded_headers = false
rate_limit_max_keys = 1000
idempotency_ttl_secs = 300
idempotency_max_keys = 1000
owner_openid = "{{sop_webhook.owner_openid}}"

# ── Tools (web search + http + fetch) ──────────────────────
{{#if llm.tavily_api_key}}
[web_search]
enabled = true
provider = "tavily"
tavily_api_key = "{{llm.tavily_api_key}}"
max_results = 10
timeout_secs = 15
{{else}}
# 没有 tavily key 时**关掉**搜索，而不是回落到 duckduckgo。
#
# 原来的回落在这台服务器上是有害的：duckduckgo 的三个端点在国内均不可达，
# 每次调用都跑满 15 秒超时才失败。实测一次企业快评有 6 次搜索、全部超时，
# 白白吃掉 90 秒（占整个流程的 43%）。更糟的是模型以为自己有搜索能力，
# 会反复重试同一个必然失败的动作，简报也因此缺少第三方信源。
#
# 关掉它，模型就知道自己只能靠已知 URL 与内部数据库，会如实说明信息来源
# 受限，而不是把时间耗在注定失败的检索上。
[web_search]
enabled = false
{{/if}}

[web_fetch]
enabled = true
allowed_domains = ["*"]
blocked_domains = []
max_response_size = 524288
timeout_secs = 30

[http_request]
enabled = true
# Whitelist (provisioner injects host names extracted from commodity.api_base
# and lead.webhook_url; empty = all hosts blocked, which prevents tools).
allowed_domains = {{{http_allowed_domains_toml}}}
max_response_size = 1048576
timeout_secs = 30

# ── Cost tracking ──────────────────────────────────────────
# zeroclaw 自带按 daemon 的成本账本（与 autonomy.max_cost_per_day_cents
# 并行，两者都跑、低的先拦）。限额是**每用户**的，币种 USD。
#
# ⚠️ 未列在 [cost.prices] 里的模型按 0 计费，限额会静默失效。换模型时
# 必须同步这张表，否则「限额配了但不生效」不会有任何报错。
#
# 汇率按 7.1 折算，与官方人民币标价对应。
[cost]
enabled = true
# 实测：一次企业快评约耗 200 万输入 token + 1.7 万输出 ≈ ¥6。
# agent loop 每轮都重发完整历史，成本几乎全在输入侧。
# 下面按「每用户每天约 3 次企业快评」设定，按实际使用情况调整。
# 联调期临时放宽到 ≈¥70/天（约 10 次企业快评）。正式运营前按真实使用
# 情况回调 —— 一次快评约 ¥6，这个上限决定单用户一天最多能跑几次。
# 注意：zeroclaw 按**业务时区**（北京时间）计算日周期，不是 UTC。
daily_limit_usd = 10.0        # ≈ ¥71/天/用户
monthly_limit_usd = 100.0     # ≈ ¥710/月/用户
warn_at_percent = 80
allow_override = false

[cost.prices."deepseek/deepseek-v4-pro"]
input = 0.423                 # USD per 1M tokens (= ¥3 官方标价)
output = 0.845                # USD per 1M tokens (= ¥6 官方标价)
