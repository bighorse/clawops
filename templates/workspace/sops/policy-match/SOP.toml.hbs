[sop]
name = "policy-match"
description = "基于企业画像匹配适用政策:同步取企业画像 + 政策清单 → LLM 匹配 + 条件分析 → 对话内回复概要 + 写库触发小程序卡片推送 + 留资跟进"
version = "1.0.0"
priority = "normal"
execution_mode = "auto"
cooldown_secs = 30
max_concurrent = 2

# 对话内由 LLM 通过 sop_execute 触发(IDENTITY.md 的 SOP 路由表)
[[triggers]]
type = "manual"

# 外部 portal/CRM 也可走 webhook 触发(payload: {enterprise_name, openid})
[[triggers]]
type = "webhook"
path = "/sop/policy-match"
